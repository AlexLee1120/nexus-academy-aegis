# Aegis Dashboard 環境變數範本
# ====================================
# 1. cp .env.example .env
# 2. 從 nexus-academy-memoria/scripts/.env 複製 PAGE_ACCESS_TOKEN / IG_BUSINESS_ID
# 3. 設 AEGIS_USERNAME / AEGIS_PASSWORD(只給 Alex Boss 用)
# 4. .env 永遠不進 git(已在 .gitignore)

# ─────────────────────────────────────
# Auth(只給 Alex Boss)
# ─────────────────────────────────────
AEGIS_USERNAME=alex
AEGIS_PASSWORD=

# ─────────────────────────────────────
# Meta API(從 Memoria scripts/.env 複製)
# ─────────────────────────────────────
PAGE_ACCESS_TOKEN=
META_PAGE_ID=1080207328515054
IG_BUSINESS_ID=17841480032513203

# ─────────────────────────────────────
# 跨 repo data path(read-only)
# ─────────────────────────────────────

# V1 vocab-flashcards repo(讀 customer_profile / subscribers)
V1_REPO_PATH=C:/Alex/Github/vocab-flashcards

# Memoria publish_log.json
PUBLISH_LOG_PATH=C:/Alex/Github/nexus-academy-memoria/scripts/publish_log.json

# Lens weekly reports
LENS_REPORTS_PATH=C:/Alex/Github/nexus-academy-memoria/docs/lens-reports

# ─────────────────────────────────────
# SQLite cache
# ─────────────────────────────────────
SQLITE_PATH=./aegis_cache.db

# ─────────────────────────────────────
# Flask(本地測試用)
# ─────────────────────────────────────
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False

# ─────────────────────────────────────
# Phase 2: LINE Bot(暫時空)
# ─────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
