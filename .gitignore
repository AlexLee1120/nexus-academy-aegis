# 機敏環境變數
.env

# GA4 Service Account JSON(私鑰,絕對不能進 git!)
service_account.json
*-service-account.json
*-iam.gserviceaccount.com.json

# SQLite cache(本地用,不進 git)
aegis_cache.db
*.db-journal
*.db-shm
*.db-wal

# 注意:aegis_cache.json 故意進 git(Phase 1.5 cache sync 機制)
# Cowork cron 每天 06:00 寫入 + git push 上 GitHub
# Render 啟動時 git pull 拿最新 cache.json
# 所以 aegis_cache.json 不在 .gitignore!

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
